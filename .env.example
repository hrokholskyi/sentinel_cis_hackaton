# Copy to .env and load with: set -a; . ./.env; set +a
# All values below are the defaults used when a variable is not set.

# Databases (paths relative to the repo root unless absolute)
BANK_DB=bank.db
BREAKER_DB=breaker.db

# Where the breaker reaches the bank, and where traffic scripts reach the breaker
BANK_URL=http://127.0.0.1:8001
BREAKER_URL=http://127.0.0.1:8000

# Rule files, loaded in file-name order at breaker start
RULES_DIR=rules

# Incident trace files
INCIDENTS_DIR=fixtures/incidents

# 1 = both services take "now" from the X-Sim-Time request header when it is present
DEMO_MODE=1

# Admin endpoints on the breaker expect this in the X-Admin-Token header
ADMIN_TOKEN=dev-admin-token

# Soft rule threshold (off_hours_amount, first_payment_above_limit)
SOFT_MIN_AMOUNT_AED=5000

# Hold time limit in minutes (used from milestone 6)
HOLD_TTL_MIN=30

# Fixed demo day: legit traffic runs the day before, soft and attack on this day at night
DEMO_DATE=2026-11-21

# Jev (layer 2): stub = no network (default), live = may release, shadow = call and log only
JEV_MODE=stub
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.13.0
JEV_T_HISTORY=0.9
JEV_T_BASIS=0.9
JEV_TIMEOUT_S=1.0
# Needed in live and shadow mode only; never commit it
TYPESAFE_API_KEY=
