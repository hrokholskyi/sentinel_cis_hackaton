# Copy to .env and load with: set -a; . ./.env; set +a
# All values below are the defaults used when a variable is not set.

# Databases (paths relative to the repo root unless absolute)
BANK_DB=bank.db
BREAKER_DB=breaker.db

# Where the breaker reaches the bank, and where traffic scripts reach the breaker
BANK_URL=http://127.0.0.1:8001
BREAKER_URL=http://127.0.0.1:8000

# Rule files, loaded in file-name order at breaker start
RULES_DIR=rules

# Incident trace files
INCIDENTS_DIR=fixtures/incidents

# 1 = both services take "now" from the X-Sim-Time request header when it is present
DEMO_MODE=1

# Admin endpoints on the breaker expect this in the X-Admin-Token header
ADMIN_TOKEN=dev-admin-token

# Soft rule threshold (off_hours_amount, first_payment_above_limit)
SOFT_MIN_AMOUNT_AED=5000

# Hold time limit in minutes (used from milestone 6)
HOLD_TTL_MIN=30

# Probe state (milestone 6): largest payment a key in probe may send, and the number of
# clean payments that bring it back to normal
PROBE_MAX_AMOUNT_AED=1000
PROBE_CLEAN_PAYMENTS=5

# Fixed demo day: legit traffic runs the day before, soft and attack on this day at night
DEMO_DATE=2026-11-21

# Jev (layer 2): stub = no network (default), live = may release, shadow = call and log only
JEV_MODE=stub
JEV_URL=https://api.typesafe.ai/v1/systemone
# Pinned version; check another one with scripts/jev_eval.py --model <name> first
JEV_MODEL=jev-1.14.0
JEV_T_HISTORY=0.9
JEV_T_BASIS=0.9
# Total budget per call, no retry (measured p95 about 280 ms on a warm connection)
JEV_TIMEOUT_S=1.0
# Needed in live and shadow mode and by scripts/jev_eval.py; never commit it
TYPESAFE_API_KEY=

# Devin webhook: POST breaker.tripped here when an incident opens (empty = no webhook)
DEVIN_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header; set it in .env, never commit a real value
DEVIN_WEBHOOK_SECRET=

# GitHub (scripts/watch_pr.sh): repo as OWNER/NAME (empty = parse the origin remote), API base, token
# (empty token = gh auth token, else unauthenticated with 60 requests per hour). Never commit a token.
GITHUB_REPO=
GITHUB_API_URL=
GITHUB_TOKEN=
# optional: comma separated logins whose pull requests the watcher accepts
WATCH_PR_AUTHORS=

# Dashboard
# Bank name in the dashboard header and in the demo captions (text only)
BANK_NAME=ADCB
